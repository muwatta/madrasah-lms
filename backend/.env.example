# Django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SECRET_KEY=change-me-to-a-long-random-string

# Database (falls back to SQLite if PostgreSQL is not reachable)
DB_NAME=madrasah_lms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth / Security
# REQUIRED when DEBUG=False (startup fails otherwise)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_HOURS=24
# REQUIRED when DEBUG=False
QR_SECRET_KEY=change-me-to-a-long-random-string

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
# REQUIRED in production: enables HMAC verification of the webhook
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me

# AI Provider (OpenAI / Groq / etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

# Email (Resend)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@madrasahlms.com
FRONTEND_URL=http://localhost:5173

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
