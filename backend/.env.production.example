# Copy to .env.production and keep it outside version control.
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=lms.example.com
CORS_ALLOWED_ORIGINS=https://lms.example.com
FRONTEND_URL=https://lms.example.com
SECRET_KEY=replace-with-at-least-50-random-characters
JWT_SECRET=replace-with-at-least-50-random-characters
QR_SECRET_KEY=replace-with-at-least-50-random-characters

DB_NAME=madrasah_lms
DB_USER=madrasah_lms
DB_PASSWORD=replace-with-a-database-password
DB_HOST=db
DB_PORT=5432
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=60

POSTGRES_PASSWORD=replace-with-the-same-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
DJANGO_ADMIN_ENABLED=False
WHATSAPP_WEBHOOK_ENABLED=False
PUBLIC_STATS_ENABLED=False
CELERY_TASK_ALWAYS_EAGER=False
DOMAIN=madrasahlms.com.ng
ACME_EMAIL=admin@madrasahlms.com.ng
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional integrations
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-token
OPENAI_API_KEY=
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
